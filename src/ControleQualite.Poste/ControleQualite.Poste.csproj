<Project Sdk="Microsoft.NET.Sdk">
  <!-- Le poste d'atelier : une application Windows native (WPF). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>ControleQualite.Poste</RootNamespace>
    <AssemblyName>PosteControleQualite</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ControleQualite.Presentation\ControleQualite.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
